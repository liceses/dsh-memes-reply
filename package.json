{
  "name": "dsh-memes-reply",
  "version": "0.1.1",
  "description": "蓝色大肥鱼表情包回复插件：模型按语境在回复里贴一张会动的大肥鱼，配置面板画在插件管理页里本插件自己的页面上（预览墙 + 下一轮指定）。素材经插件自有 HTTP 路由直出，不经过附件流水线（那会把动画压成静图）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.3"
  },
  "scripts": {
    "build": "node scripts/build-client-vocab.mjs && tsc -p tsconfig.build.json && tsdown",
    "build:client": "node scripts/build-client-vocab.mjs && tsdown",
    "typecheck": "tsc --noEmit",
    "check:client": "node scripts/check-client-purity.mjs",
    "pretest": "npm run build && npm run check:client",
    "test": "node --test \"test/*.test.mjs\"",
    "import-assets": "node scripts/import-assets.mjs",
    "assets:pack": "node scripts/pack-assets.mjs",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/client.js",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-fs": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "semver": "^7.8.5",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liceses/dsh-memes-reply.git"
  },
  "homepage": "https://github.com/liceses/dsh-memes-reply#readme",
  "bugs": {
    "url": "https://github.com/liceses/dsh-memes-reply/issues"
  }
}
